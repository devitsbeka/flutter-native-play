# Copy to .env and fill in. The repo does not carry a real .env — it used to,
# and although it only held the Supabase URL and the publishable (anon) key,
# which are designed to be public, it was the obvious place for someone to
# add a secret next.

# ── Supabase (publishable values; safe in a client bundle) ────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── RevenueCat ────────────────────────────────────────────────────────────
# Public SDK keys, one per platform. Without these the paywall renders with
# no products; the app now says so in the console rather than failing quietly.
# The *secret* key is a Supabase secret, never here.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# ── AdMob ad units ────────────────────────────────────────────────────────
# Per platform, per placement. A missing value falls back to Google's demo
# unit, which serves ads and earns nothing.
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_ANDROID_INTERSTITIAL=

# ── Video hosting ─────────────────────────────────────────────────────────
# Absolute origin serving /videos/*. Required for native builds, which strip
# the video library out of the app bundle and stream it instead. Empty on web
# means same-origin.
VITE_VIDEO_BASE_URL=
# Set to "true" once mobile/*.mp4 variants exist (see ACTION_ITEMS.md). Until
# then phones below iOS 17.4, which cannot play WebM, get the desktop MP4.
VITE_MOBILE_MP4_AVAILABLE=

# ── Build flags ───────────────────────────────────────────────────────────
# Set false for store builds so the admin console is not compiled in.
VITE_INCLUDE_ADMIN=
# Set true for native builds; strips web-only markup such as the Meta Pixel.
VITE_NATIVE_BUILD=
# Overrides the canonical public URL used for share and invite links.
VITE_PUBLIC_SITE_URL=

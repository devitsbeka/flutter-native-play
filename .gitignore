# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build state (written by `tsc -b`)
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cloudflare Wrangler local dev state
.wrangler/

# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/

# .env IS tracked, deliberately — see the note at the top of .env.example.
# It holds only the Supabase project ref and the publishable (anon) key, both
# public by design, and three separate build systems read it.
.env.local
.env.*.local

# Generated by scripts/capture-store-screenshots.mjs — regenerable, not source.
screenshots/

# Firebase config for the iOS app. Not secret — it holds the project id, the
# sender id and a public API key, all of which ship inside the binary anyway —
# but it is per-project, and a stale one silently points push at a Firebase
# project that no longer exists. Fetched from the console instead:
# Project settings -> General -> Your apps -> GoogleService-Info.plist
ios/App/App/GoogleService-Info.plist

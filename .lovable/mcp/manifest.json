{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sqwpzezkhpqkdyltvsim.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "trivia-battle",
      "version": "0.1.0",
      "title": "Trivia Battle"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List trivia categories",
        "description": "List active trivia categories, optionally filtered by language or a name search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "description": "Language code such as 'en' or 'ka'."
            },
            "search": {
              "type": "string",
              "description": "Case-insensitive substring of the category name."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of categories to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_questions",
        "title": "List trivia questions",
        "description": "List active trivia questions for a category, including the correct and incorrect answers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category_id": {
              "type": "string",
              "description": "Category id to list questions for."
            },
            "difficulty": {
              "type": "string",
              "description": "Optional difficulty filter."
            },
            "language": {
              "type": "string",
              "description": "Optional language code filter, e.g. 'en'."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum questions to return (default 20)."
            }
          },
          "required": [
            "category_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in player's profile: nickname, points, coins, gems, streaks and game record.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_progress",
        "title": "Get my category progress",
        "description": "Return the signed-in player's per-category progress: questions answered, correct, and completion.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category_id": {
              "type": "string",
              "description": "Restrict the result to one category id."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}

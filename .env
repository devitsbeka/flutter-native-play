# RevenueCat public SDK key. Ships inside the app binary and is readable by
# anyone who downloads it, same as the anon key above — it identifies the app
# to RevenueCat, it does not authorise anything. The secret `sk_` key is a
# different thing entirely and is a Supabase platform secret; it must never
# appear in a VITE_ var, because that compiles it into the bundle.
#
# Only native builds read it (useInAppPurchases returns early on web), but it
# lives here rather than on one machine so a fresh clone can `npm run
# build:ios` without configuration. Missing, it does not throw: configure()
# succeeds, getOfferings() returns nothing, and the paywall renders empty with
# a single console warning.
VITE_REVENUECAT_IOS_API_KEY="appl_nwvpKSeshXnefvnycQWAjoAuKLo"

# AdMob ad units for iOS. Public like the keys above — they ship in the binary
# and identify a placement, they authorise nothing.
#
# Note the punctuation, because the two are easy to swap and neither fails
# loudly: an app id uses `~` (ca-app-pub-...~1525220642, in Info.plist as
# GADApplicationIdentifier) and an ad unit uses `/`.
#
# Unset, adService.ts falls back to Google's demo units, which serve ads
# perfectly and earn nothing.
VITE_ADMOB_IOS_INTERSTITIAL="ca-app-pub-3462589915085372/2581000642"
VITE_ADMOB_IOS_REWARDED="ca-app-pub-3462589915085372/8352202074"

# Meta APP id, for the Messenger Send Dialog — the composer that lets someone
# pick a conversation and attaches the link to it. Public like everything else
# here; it identifies the app to Facebook and authorises nothing.
#
# NOT the Pixel id in index.html (845894748475852). They are different objects
# in different products and pasting the Pixel here fails in the worst way: the
# dialog opens and then refuses, so the button looks like it works and does
# not. Get the real one from developers.facebook.com → your app → Settings →
# Basic → "App ID", and the app needs mytrivia.io added under App Domains
# before Facebook will accept a redirect back to it.
#
# Empty is handled and is the current state: the share row hands Messenger the
# link through the system share sheet instead — one extra tap, and it works on
# a phone. Filling this in is what makes the button open Messenger directly.
VITE_FACEBOOK_APP_ID=""
# The mobile H.264 tier in public/videos/mobile/ now exists (63 clips, built by
# scripts/convert-videos-mobile-mp4.sh). getResponsiveVideoSrc reads this flag
# rather than probing for the files, so phones keep getting the 720p desktop
# MP4 until it is true. Only flip it back if that directory is emptied, or the
# <source> chain will point at 404s on every device below iOS 17.4.
VITE_MOBILE_MP4_AVAILABLE=true

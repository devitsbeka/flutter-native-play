# Cloudflare edge headers. Vite copies this file into dist/ verbatim.
# Rules are matched most-specific-first; later blocks do not override earlier
# matches for the same header on the same path.

# Vite writes content-hashed filenames into /assets, so those URLs can never
# point at different bytes. Cache them permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Videos are ~280 MB of the build and their names are NOT hashed, so this is a
# deliberate trade: a long cache keeps players off their mobile data, and a
# changed video needs a new filename (or a cache purge) to propagate.
/videos/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale, or clients pin themselves to
# an old build.
/sw.js
  Cache-Control: no-cache

# The HTML shell references the hashed asset URLs, so it is the one file that
# has to be revalidated on every load for a deploy to take effect.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Rewritten by every deploy and polled by the stale-build guard, so it must
# never be answered from a cache.
/version.json
  Cache-Control: no-store

# Universal links. Apple's CDN requires application/json, and the file has no
# extension for the server to infer it from — the extension is omitted because
# Apple fetches this exact path. A wrong content type fails silently: links
# just keep opening in Safari.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

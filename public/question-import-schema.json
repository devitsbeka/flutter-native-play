{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trivia Question Bulk Import Schema",
  "description": "Schema for bulk importing trivia questions. AI agents should generate arrays of questions following this format.",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category_slug", "question_text", "correct_answer", "incorrect_answers", "difficulty", "language"],
        "properties": {
          "category_slug": {
            "type": "string",
            "description": "Category identifier slug. Must match one of the predefined category slugs listed below.",
            "enum": [
              "anime_manga", "archaeology", "architecture", "astronomy", "biology",
              "nature", "geography", "geology", "ecology", "economics",
              "languages", "video_games", "movies", "space", "math",
              "medicine", "memes_internet", "science", "myths_reality", "fashion",
              "world_history", "world_cuisine", "music", "politics", "pop_culture",
              "programming", "religion_mythology", "robotics_ai", "military_history",
              "georgian_history", "fun_facts", "tv_series", "social_media", "sports",
              "technology", "physics", "philosophy", "psychology", "georgian_culture",
              "georgian_literature", "georgian_cuisine", "chemistry", "celebrities",
              "animals", "art"
            ]
          },
          "question_text": {
            "type": "string",
            "maxLength": 65,
            "minLength": 5,
            "description": "The question text. MUST end with '?'. Maximum 65 characters including the question mark. Should be clear, concise, and factually accurate."
          },
          "correct_answer": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "description": "The correct answer. Maximum 20 characters. MUST NOT appear as a substring in the question_text."
          },
          "incorrect_answers": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 20,
              "minLength": 1
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "Exactly 3 incorrect (distractor) answers. Each max 20 characters. Should be plausible but clearly wrong. The length difference between the longest and shortest answer (including correct) should not exceed 8 characters."
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "description": "Question difficulty level. easy = common knowledge, medium = requires some domain knowledge, hard = expert-level knowledge."
          },
          "language": {
            "type": "string",
            "enum": ["ka", "en", "fr", "de", "es", "it", "pt-br"],
            "description": "Language code. 'ka' = Georgian (primary), 'en' = English, etc."
          },
          "icon_keyword": {
            "type": "string",
            "description": "Optional hint keyword for icon matching (e.g. 'planet', 'dna', 'pyramid'). MUST NOT be the same as or hint at the correct_answer. Used by the system to auto-assign a 3D icon from the library.",
            "maxLength": 30
          }
        },
        "additionalProperties": false
      }
    }
  },
  "examples": [
    {
      "questions": [
        {
          "category_slug": "astronomy",
          "question_text": "რომელია მზის სისტემის ყველაზე დიდი პლანეტა?",
          "correct_answer": "იუპიტერი",
          "incorrect_answers": ["სატურნი", "მარსი", "ნეპტუნი"],
          "difficulty": "easy",
          "language": "ka",
          "icon_keyword": "planet"
        },
        {
          "category_slug": "astronomy",
          "question_text": "What is the closest star to Earth?",
          "correct_answer": "The Sun",
          "incorrect_answers": ["Alpha Centauri", "Sirius", "Betelgeuse"],
          "difficulty": "easy",
          "language": "en",
          "icon_keyword": "star"
        },
        {
          "category_slug": "world_history",
          "question_text": "რომელ წელს დაიწყო პირველი მსოფლიო ომი?",
          "correct_answer": "1914",
          "incorrect_answers": ["1916", "1912", "1918"],
          "difficulty": "medium",
          "language": "ka",
          "icon_keyword": "war"
        },
        {
          "category_slug": "biology",
          "question_text": "რა არის ადამიანის სხეულის უდიდესი ორგანო?",
          "correct_answer": "კანი",
          "incorrect_answers": ["ღვიძლი", "ტვინი", "გული"],
          "difficulty": "medium",
          "language": "ka",
          "icon_keyword": "anatomy"
        },
        {
          "category_slug": "geography",
          "question_text": "Quelle est la capitale de la France?",
          "correct_answer": "Paris",
          "incorrect_answers": ["Lyon", "Marseille", "Toulouse"],
          "difficulty": "easy",
          "language": "fr",
          "icon_keyword": "city"
        }
      ]
    }
  ],
